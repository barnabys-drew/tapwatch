# Copy to deploy/fleet/.env (git ignores it) and fill in. Make the secrets with:  openssl rand -base64 32
FLEET_MYSQL_PASSWORD=
# Signs Fleet's sessions; at least 32 characters.
FLEET_SERVER_PRIVATE_KEY=
# The account tapwatch runs as (id -u / id -g), so tapwatch can read the results log Fleet writes.
FLEET_UID=1000
FLEET_GID=1000
# The https address agents reach Fleet at (tailscale serve in front of 127.0.0.1:8412), for agent-bundle.sh.
FLEET_URL=
# An API-only user's token (docs/setup/fleet.md), for agent-bundle.sh and `fleetctl apply`.
FLEET_API_TOKEN=
