<!--
  Small Sysmon config for a home machine. Goal: answer "which program made this
  connection?" for network alerts, plus basic process history.

  Logged: process starts (1), network connections (3, except loopback),
  process ends (5), DNS queries (22), files created in a Startup folder (11, R39), and other programs opening lsass.exe (10, R29: credential theft reads
  its memory), minus the Windows components that do so all the time. Everything else is off to keep the
  log small.
  For a fuller config see https://github.com/olafhartong/sysmon-modular.
-->
<Sysmon schemaversion="4.50">
  <HashAlgorithms>sha256</HashAlgorithms>
  <CheckRevocation/>
  <EventFiltering>
    <RuleGroup name="process create" groupRelation="or">
      <ProcessCreate onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="network connect" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <DestinationIp condition="is">127.0.0.1</DestinationIp>
        <DestinationIp condition="is">::1</DestinationIp>
      </NetworkConnect>
    </RuleGroup>
    <RuleGroup name="process terminate" groupRelation="or">
      <ProcessTerminate onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="dns query" groupRelation="or">
      <DnsQuery onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="lsass access" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage condition="end with">\lsass.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>
    <RuleGroup name="lsass access: Windows itself" groupRelation="or">
      <ProcessAccess onmatch="exclude">
        <SourceImage condition="is">C:\Windows\system32\svchost.exe</SourceImage>
        <SourceImage condition="is">C:\Windows\system32\wininit.exe</SourceImage>
        <SourceImage condition="is">C:\Windows\system32\csrss.exe</SourceImage>
        <SourceImage condition="is">C:\Windows\system32\services.exe</SourceImage>
        <SourceImage condition="is">C:\Windows\system32\wbem\wmiprvse.exe</SourceImage>
        <!-- Defender and Defender for Endpoint, by folder too: a program merely named MsMpEng.exe elsewhere still counts -->
        <Rule groupRelation="and">
          <SourceImage condition="begin with">C:\ProgramData\Microsoft\Windows Defender\Platform\</SourceImage>
          <SourceImage condition="end with">\MsMpEng.exe</SourceImage>
        </Rule>
        <Rule groupRelation="and">
          <SourceImage condition="begin with">C:\ProgramData\Microsoft\Windows Defender\Platform\</SourceImage>
          <SourceImage condition="end with">\MpDefenderCoreService.exe</SourceImage>
        </Rule>
        <Rule groupRelation="and">
          <SourceImage condition="begin with">C:\ProgramData\Microsoft\Windows Defender\Platform\</SourceImage>
          <SourceImage condition="end with">\NisSrv.exe</SourceImage>
        </Rule>
        <SourceImage condition="is">C:\Program Files\Windows Defender Advanced Threat Protection\MsSense.exe</SourceImage>
        <!-- Query-only opens (limited information, with or without full information): no memory read, so R29 ignores
             them anyway. Measured 2026-10-19: 8,823 lsass opens in 6 hours, every one 0x1000, 99% powershell.exe. -->
        <GrantedAccess condition="is">0x1000</GrantedAccess>
        <GrantedAccess condition="is">0x1400</GrantedAccess>
      </ProcessAccess>
    </RuleGroup>
    <!-- R39: a file dropped in a Startup folder runs at the next sign-in (T1547.001). Only those folders, so the
         event stays rare; Sysmon names the program that wrote it. -->
    <RuleGroup name="startup folder drops" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="contains">\Start Menu\Programs\Startup\</TargetFilename>
      </FileCreate>
    </RuleGroup>
    <!-- Off: empty include rules match nothing. -->
    <RuleGroup name="off" groupRelation="or">
      <FileCreateTime onmatch="include"/>
      <DriverLoad onmatch="include"/>
      <ImageLoad onmatch="include"/>
      <CreateRemoteThread onmatch="include"/>
      <RawAccessRead onmatch="include"/>
      <RegistryEvent onmatch="include"/>
      <FileCreateStreamHash onmatch="include"/>
      <PipeEvent onmatch="include"/>
      <WmiEvent onmatch="include"/>
      <FileDelete onmatch="include"/>
      <ClipboardChange onmatch="include"/>
      <ProcessTampering onmatch="include"/>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
