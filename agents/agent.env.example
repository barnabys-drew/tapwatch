# Copy to agent.env (gitignored) to point every install at a Fleet server.
# Leave FLEET_URL empty (or don't create agent.env) for standalone mode.
FLEET_URL=
ENROLL_SECRET=
# Path to Fleet's TLS certificate, relative to the repo root. Needed when Fleet uses a
# self-signed certificate; leave empty if it has a publicly trusted one.
FLEET_CERT=
