# Linux only, appended by install.sh: osquery's eBPF publisher, so the bpf_connections query (osquery.conf)
# sees every outgoing connection with the process behind it, not just the ones open at a 1-minute snapshot.
# Needs a kernel with BPF and BTF (4.18+; WSL2's kernel has both).
--disable_events=false
--enable_bpf_events=true
--enable_file_events=true
# The eBPF publisher hands events over through one perf ring per CPU of (2^exp + 1) pages, mapped into
# the worker: the default exp 10 is 4 MB a CPU, 64 MB on 16 cores, and on such a PC the worker sat at
# 175-185 MB against the watchdog's 200 MB, so ordinary swings got it killed every few hours (2026-10-25).
# 9 halves the ring; osquery drains it at least once a second, which 2 MB a CPU covers.
--bpf_perf_event_array_exp=9
# Events wait in osquery's database between scheduled runs; drop them after an hour if unread.
--events_expiry=3600
--events_max=200000
# Every connection makes the results log busier: rotate at 100 MB, keep 10 files.
--logger_rotate=true
--logger_rotate_size=104857600
--logger_rotate_max_files=10
